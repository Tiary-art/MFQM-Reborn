+        SUITES.put(p.getUUID(), new Suite(cases, 0, p.level().getGameTime(), prefix));
+        p.sendSystemMessage(Component.literal("MFQM motion suite: " + cases.size() + " real-tick fixtures; remain connected/unpaused. /mfqm motion stop"));
